@page "/guests"
@inject IGuestService GuestSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using HotelManager.Infrastructure.Services

<PageTitle>Guests - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Guests</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="3"><MudTextField Value="_guest.GuestID" Label="Guest ID" ReadOnly="true" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.GuestName" Label="Guest Name" Required="true" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.Address" Label="Address" Required="true" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.City" Label="City" Required="true" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.ContactNo" Label="Contact No" Required="true" /></MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect @bind-Value="_guest.IDType" Label="ID Type" Required="true">
                @foreach (var type in GuestService.IdTypes)
                {
                    <MudSelectItem Value="@type">@type</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.IDNumber" Label="ID Number" Required="true" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_guest.Notes" Label="Notes" /></MudItem>
        <MudItem xs="12" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@(_editing ? "Update" : "Add")</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTextField Value="_search" ValueChanged="@(async (string s) => { _search = s; await Load(); })"
              Label="Search by Guest Name" Immediate="true" Class="mb-2"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

<MudTable Items="_guests" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>Guest ID</MudTh>
        <MudTh>Guest Name</MudTh>
        <MudTh>Address</MudTh>
        <MudTh>City</MudTh>
        <MudTh>Contact No</MudTh>
        <MudTh>ID Type</MudTh>
        <MudTh>ID Number</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.GuestID</MudTd>
        <MudTd>@context.GuestName</MudTd>
        <MudTd>@context.Address</MudTd>
        <MudTd>@context.City</MudTd>
        <MudTd>@context.ContactNo</MudTd>
        <MudTd>@context.IDType</MudTd>
        <MudTd>@context.IDNumber</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Delete(context.GuestID))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<Guest> _guests = [];
    private Guest _guest = new() { GuestID = "" };
    private string _search = "";
    private bool _editing;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() =>
        _guests = await GuestSvc.GetAllAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);

    private void ResetForm()
    {
        _guest = new Guest { GuestID = "" };
        _editing = false;
    }

    private void Edit(Guest guest)
    {
        _guest = new Guest
        {
            GuestID = guest.GuestID,
            GuestName = guest.GuestName,
            Address = guest.Address,
            City = guest.City,
            ContactNo = guest.ContactNo,
            IDType = guest.IDType,
            IDNumber = guest.IDNumber,
            Notes = guest.Notes
        };
        _editing = true;
    }

    private async Task Save()
    {
        try
        {
            if (_editing)
            {
                await GuestSvc.UpdateAsync(_guest);
                Snackbar.Add("Successfully updated", Severity.Success);
            }
            else
            {
                await GuestSvc.CreateAsync(_guest);
                Snackbar.Add("Successfully saved", Severity.Success);
            }
            ResetForm();
            await Load();
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task Delete(string guestId)
    {
        var confirmed = await DialogService.ShowMessageBox("Confirmation",
            "Do you really want to delete this record?", yesText: "Yes", noText: "No");
        if (confirmed != true) return;
        await GuestSvc.DeleteAsync(guestId);
        Snackbar.Add("Successfully deleted", Severity.Success);
        ResetForm();
        await Load();
    }
}
