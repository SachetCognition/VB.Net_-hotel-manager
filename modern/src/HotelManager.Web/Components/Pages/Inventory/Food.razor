@page "/inventory/food"
@inject IInventoryService Inventory
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState

<PageTitle>Food - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Food (Dishes)</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_dishName" Label="Dish Name" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_category" Label="Category" /></MudItem>
        <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_rate" Label="Rate" Min="0" /></MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isAdmin)" OnClick="Save">
                @(_editId == 0 ? "Save" : "Update")
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
        </MudItem>
    </MudGrid>
    @if (!_isAdmin)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning">Only Admin users can save or delete records.</MudText>
    }
</MudPaper>

<MudTextField Value="_search" ValueChanged="@((string s) => SearchChanged(s))" Immediate="true"
              Label="Search by dish name" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-2" />

<MudTable Items="_dishes" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>ID</MudTh><MudTh>Dish Name</MudTh><MudTh>Category</MudTh><MudTh>Rate</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.ID</MudTd>
        <MudTd>@context.DishName</MudTd>
        <MudTd>@context.Category</MudTd>
        <MudTd>@context.Rate</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           Disabled="@(!_isAdmin)" OnClick="@(() => Delete(context.ID))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<Dish> _dishes = [];
    private string _search = "";
    private string _dishName = "";
    private string _category = "";
    private int? _rate;
    private int _editId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
        await Load();
    }

    private async Task Load() => _dishes = await Inventory.GetDishesAsync(_search);

    private async Task SearchChanged(string value)
    {
        _search = value;
        await Load();
    }

    private void Edit(Dish dish)
    {
        _editId = dish.ID;
        _dishName = dish.DishName ?? "";
        _category = dish.Category ?? "";
        _rate = dish.Rate;
    }

    private void ResetForm()
    {
        _editId = 0;
        _dishName = _category = "";
        _rate = null;
    }

    private async Task Save()
    {
        if (!_isAdmin) { Snackbar.Add("Only Admin users can save records", Severity.Error); return; }
        try
        {
            await Inventory.SaveDishAsync(new Dish { ID = _editId, DishName = _dishName, Category = _category, Rate = _rate });
            Snackbar.Add(_editId == 0 ? "Successfully saved" : "Successfully updated", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete(int id)
    {
        if (!_isAdmin) { Snackbar.Add("Only Admin users can delete records", Severity.Error); return; }
        try
        {
            await Inventory.DeleteDishAsync(id);
            Snackbar.Add("Successfully deleted", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
