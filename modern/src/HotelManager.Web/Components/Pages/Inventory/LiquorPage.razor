@page "/inventory/liquor"
@inject IInventoryService Inventory
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState

<PageTitle>Liquor - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Liquor</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect @bind-Value="_liquorName" Label="Liquor Name">
                @foreach (var m in _masters)
                {
                    <MudSelectItem Value="@m.LiquorName">@m.LiquorName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_volume" Label="Volume (ml)" Min="0" /></MudItem>
        <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_rate" Label="Rate" Min="0" /></MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isAdmin)" OnClick="Save">
                @(_editId == 0 ? "Save" : "Update")
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
        </MudItem>
    </MudGrid>
    @if (!_isAdmin)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning">Only Admin users can save or delete records.</MudText>
    }
</MudPaper>

<MudTextField Value="_search" ValueChanged="@((string s) => SearchChanged(s))" Immediate="true"
              Label="Search by liquor name" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-2" />

<MudTable Items="_liquors" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>ID</MudTh><MudTh>Liquor Name</MudTh><MudTh>Volume</MudTh><MudTh>Rate</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.ID</MudTd>
        <MudTd>@context.LiquorName</MudTd>
        <MudTd>@context.Volume</MudTd>
        <MudTd>@context.Rate</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           Disabled="@(!_isAdmin)" OnClick="@(() => Delete(context.ID))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<Liquor> _liquors = [];
    private IReadOnlyList<LiquorMaster> _masters = [];
    private string _search = "";
    private string _liquorName = "";
    private int? _volume;
    private int? _rate;
    private int _editId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");
        _masters = await Inventory.GetLiquorMastersAsync();
        await Load();
    }

    private async Task Load() => _liquors = await Inventory.GetLiquorsAsync(_search);

    private async Task SearchChanged(string value)
    {
        _search = value;
        await Load();
    }

    private void Edit(Liquor liquor)
    {
        _editId = liquor.ID;
        _liquorName = liquor.LiquorName ?? "";
        _volume = liquor.Volume;
        _rate = liquor.Rate;
    }

    private void ResetForm()
    {
        _editId = 0;
        _liquorName = "";
        _volume = _rate = null;
    }

    private async Task Save()
    {
        if (!_isAdmin) { Snackbar.Add("Only Admin users can save records", Severity.Error); return; }
        try
        {
            await Inventory.SaveLiquorAsync(new Liquor { ID = _editId, LiquorName = _liquorName, Volume = _volume, Rate = _rate });
            Snackbar.Add(_editId == 0 ? "Successfully saved" : "Successfully updated", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete(int id)
    {
        if (!_isAdmin) { Snackbar.Add("Only Admin users can delete records", Severity.Error); return; }
        try
        {
            await Inventory.DeleteLiquorAsync(id);
            Snackbar.Add("Successfully deleted", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
