@page "/hr/advances"
@inject IHrPayrollService Hr
@inject ISnackbar Snackbar

<PageTitle>Advance / Deduction Entry - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Advance / Deduction Entry</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="_employeeId" Label="Employee">
                @foreach (var e in _employees)
                {
                    <MudSelectItem Value="@e.EmployeeID">@e.EmployeeID — @e.EmployeeName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="_entryDate" Label="Entry Date" /></MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect @bind-Value="_entryType" Label="Type">
                <MudSelectItem Value="@("Advance")">Advance</MudSelectItem>
                <MudSelectItem Value="@("Deduction")">Deduction</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_amount" Label="Amount" Min="0" /></MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Outstanding Advance by Employee</MudText>
<MudTable Items="_summary" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>Employee</MudTh><MudTh>Total Advance</MudTh><MudTh>Total Deduction</MudTh><MudTh>Outstanding</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Employee</MudTd>
        <MudTd>@context.Advance</MudTd>
        <MudTd>@context.Deduction</MudTd>
        <MudTd>@context.Outstanding</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private record AdvanceSummary(string Employee, int Advance, int Deduction, int Outstanding);

    private IReadOnlyList<EmployeeRegistration> _employees = [];
    private IReadOnlyList<AdvanceSummary> _summary = [];
    private string _employeeId = "";
    private DateTime? _entryDate = DateTime.Today;
    private string _entryType = "Advance";
    private int _amount;

    protected override async Task OnInitializedAsync()
    {
        _employees = await Hr.GetEmployeesAsync();
        await Load();
    }

    private async Task Load()
    {
        var entries = await Hr.GetAdvanceEntriesAsync();
        _summary = entries
            .GroupBy(e => e.EmployeeID ?? "")
            .Select(g => new AdvanceSummary(
                $"{g.Key} — {_employees.FirstOrDefault(e => e.EmployeeID == g.Key)?.EmployeeName}",
                g.Sum(e => e.Amount ?? 0),
                g.Sum(e => e.Deduction ?? 0),
                g.Sum(e => e.Amount ?? 0) - g.Sum(e => e.Deduction ?? 0)))
            .OrderBy(s => s.Employee)
            .ToList();
    }

    private async Task Save()
    {
        try
        {
            await Hr.SaveAdvanceEntryAsync(new AdvanceEntry
            {
                EmployeeID = _employeeId,
                WorkingDate = _entryDate,
                Amount = _entryType == "Advance" ? _amount : 0,
                Deduction = _entryType == "Deduction" ? _amount : 0
            });
            Snackbar.Add("Advance Successfully saved", Severity.Success);
            _amount = 0;
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
