@page "/hr/employees"
@inject IHrPayrollService Hr
@inject ISnackbar Snackbar

<PageTitle>Employees - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Employee Registration</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">@(_editing ? $"Edit {_model.EmployeeID}" : "New Employee")</MudText>
    <MudGrid>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.EmployeeName" Label="Full Name" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.Address" Label="Address" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.MobileNo" Label="Mobile No" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.Email" Label="Email" /></MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect @bind-Value="_model.Bloodgroup" Label="Gender">
                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_model.Department" Label="Department" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_model.Designation" Label="Designation" /></MudItem>
        <MudItem xs="12" sm="3"><MudDatePicker @bind-Date="_model.DateOfJoining" Label="Date of Joining" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField @bind-Value="_model.Salary" Label="Basic Salary" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_model.BasicWorkingTime" Label="Basic Working Time (hh:mm:ss)" /></MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@(_editing ? "Update" : "Save")</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTextField T="string" Value="_search" ValueChanged="OnSearch" Label="Search by name" Immediate="true"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

<MudTable Items="_employees" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>ID</MudTh><MudTh>Name</MudTh><MudTh>Mobile</MudTh><MudTh>Department</MudTh>
        <MudTh>Designation</MudTh><MudTh>Joined</MudTh><MudTh>Salary</MudTh><MudTh>Working Time</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.EmployeeID</MudTd>
        <MudTd>@context.EmployeeName</MudTd>
        <MudTd>@context.MobileNo</MudTd>
        <MudTd>@context.Department</MudTd>
        <MudTd>@context.Designation</MudTd>
        <MudTd>@context.DateOfJoining?.ToShortDateString()</MudTd>
        <MudTd>@context.Salary</MudTd>
        <MudTd>@context.BasicWorkingTime</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Delete(context.EmployeeID))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<EmployeeRegistration> _employees = [];
    private EmployeeRegistration _model = new() { EmployeeID = "", DateOfJoining = DateTime.Today };
    private bool _editing;
    private string _search = "";

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() => _employees = await Hr.GetEmployeesAsync(_search);

    private async Task OnSearch(string value)
    {
        _search = value;
        await Load();
    }

    private void Edit(EmployeeRegistration e)
    {
        _model = new EmployeeRegistration
        {
            EmployeeID = e.EmployeeID, EmployeeName = e.EmployeeName, Address = e.Address,
            MobileNo = e.MobileNo, Email = e.Email, Bloodgroup = e.Bloodgroup,
            Department = e.Department, Designation = e.Designation,
            DateOfJoining = e.DateOfJoining, Salary = e.Salary, BasicWorkingTime = e.BasicWorkingTime
        };
        _editing = true;
    }

    private void ResetForm()
    {
        _model = new EmployeeRegistration { EmployeeID = "", DateOfJoining = DateTime.Today };
        _editing = false;
    }

    private async Task Save()
    {
        try
        {
            await Hr.SaveEmployeeAsync(_model, !_editing);
            Snackbar.Add(_editing ? "Emplyee Record Successfully updated" : "Employee Profile Successfully saved", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Delete(string id)
    {
        try
        {
            await Hr.DeleteEmployeeAsync(id);
            Snackbar.Add("Record Successfully deleted", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
