@page "/hr/advance-records"
@inject IHrPayrollService Hr
@inject ISnackbar Snackbar

<PageTitle>Advance Records - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Advance / Deduction Records</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="_employeeId" Label="Employee" Clearable="true">
                @foreach (var e in _employees)
                {
                    <MudSelectItem Value="@e.EmployeeID">@e.EmployeeID — @e.EmployeeName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Search</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_entries" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>Date</MudTh><MudTh>Employee</MudTh><MudTh>Advance</MudTh><MudTh>Deduction</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.WorkingDate?.ToShortDateString()</MudTd>
        <MudTd>@context.EmployeeID @(context.Employee is null ? "" : $"— {context.Employee.EmployeeName}")</MudTd>
        <MudTd>@context.Amount</MudTd>
        <MudTd>@context.Deduction</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Delete(context.ID))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<EmployeeRegistration> _employees = [];
    private IReadOnlyList<AdvanceEntry> _entries = [];
    private string? _employeeId;

    protected override async Task OnInitializedAsync()
    {
        _employees = await Hr.GetEmployeesAsync();
        await Load();
    }

    private async Task Load() => _entries = await Hr.GetAdvanceEntriesAsync(_employeeId);

    private async Task Delete(int id)
    {
        await Hr.DeleteAdvanceEntryAsync(id);
        Snackbar.Add("Successfully deleted", Severity.Success);
        await Load();
    }
}
