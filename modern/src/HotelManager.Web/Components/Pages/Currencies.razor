@page "/currencies"
@inject ICurrencyService CurrencySvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Currencies - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Currencies</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_currencyName" Label="Currency" Required="true" RequiredError="Currency is required" /></MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@(_editId is null ? "Add" : "Update")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

<MudDataGrid Items="_currencies" Dense="true" Hover="true" Elevation="2" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="c => c.ID" Title="ID" />
        <PropertyColumn Property="c => c.CS_Currency" Title="Currency" />
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Edit(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Delete(context.Item.ID))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText>No currencies found.</MudText></NoRecordsContent>
</MudDataGrid>

@code {
    private MudForm _form = null!;
    private IReadOnlyList<CurrencySet> _currencies = [];
    private string _currencyName = "";
    private int? _editId;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _currencies = await CurrencySvc.GetAllAsync();

    private void ResetForm()
    {
        _currencyName = "";
        _editId = null;
    }

    private void Edit(CurrencySet currency)
    {
        _editId = currency.ID;
        _currencyName = currency.CS_Currency ?? "";
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        try
        {
            if (_editId is null)
            {
                await CurrencySvc.CreateAsync(new CurrencySet { CS_Currency = _currencyName });
                Snackbar.Add("Currency Successfully saved", Severity.Success);
            }
            else
            {
                await CurrencySvc.UpdateAsync(new CurrencySet { ID = _editId.Value, CS_Currency = _currencyName });
                Snackbar.Add("Record Successfully updated", Severity.Success);
            }
            ResetForm();
            await Load();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task Delete(int id)
    {
        var confirmed = await DialogService.ShowMessageBox("Confirmation",
            "Do you really want to delete this record?", yesText: "Yes", noText: "No");
        if (confirmed != true) return;
        try
        {
            await CurrencySvc.DeleteAsync(id);
            Snackbar.Add("Record Successfully deleted", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
