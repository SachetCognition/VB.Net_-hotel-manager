@page "/halls"
@inject IRoomService RoomSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Halls - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Halls</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_hallName" Label="Hall Name" Required="true" RequiredError="Hall name is required" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_charges" Label="Charges" Min="0" /></MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@(_editId is null ? "Add" : "Update")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ResetForm">New</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

<MudDataGrid Items="_halls" Dense="true" Hover="true" Elevation="2" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="h => h.ID" Title="ID" />
        <PropertyColumn Property="h => h.HallName" Title="Hall Name" />
        <PropertyColumn Property="h => h.Charges" Title="Charges" />
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Edit(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Delete(context.Item.ID))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText>No halls found.</MudText></NoRecordsContent>
</MudDataGrid>

@code {
    private MudForm _form = null!;
    private IReadOnlyList<Hall> _halls = [];
    private string _hallName = "";
    private int? _charges;
    private int? _editId;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _halls = await RoomSvc.GetHallsAsync();

    private void ResetForm()
    {
        _hallName = "";
        _charges = null;
        _editId = null;
    }

    private void Edit(Hall hall)
    {
        _editId = hall.ID;
        _hallName = hall.HallName ?? "";
        _charges = hall.Charges;
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        try
        {
            await RoomSvc.SaveHallAsync(new Hall { ID = _editId ?? 0, HallName = _hallName, Charges = _charges });
            Snackbar.Add(_editId is null ? "Hall Charge Successfully saved" : "Record Successfully updated", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task Delete(int id)
    {
        var confirmed = await DialogService.ShowMessageBox("Confirmation",
            "Do you really want to delete this record?", yesText: "Yes", noText: "No");
        if (confirmed != true) return;
        try
        {
            await RoomSvc.DeleteHallAsync(id);
            Snackbar.Add("Record Successfully deleted", Severity.Success);
            ResetForm();
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
