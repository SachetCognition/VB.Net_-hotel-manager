@page "/check-out"
@inject ICheckInService CheckInSvc
@inject ICheckOutService CheckOutSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Check Out - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Room Check Out</MudText>

<MudText Typo="Typo.h6" Class="mb-2">Checked In Guests</MudText>
<MudDataGrid Items="_checkedIn" Dense="true" Hover="true" Elevation="2" Class="mb-4"
             Filterable="true" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="c => c.ID" Title="ID" />
        <PropertyColumn Property="c => c.Guest != null ? c.Guest.GuestName : c.GuestID" Title="Guest" />
        <PropertyColumn Property="c => c.RoomNo" Title="Room" />
        <PropertyColumn Property="c => c.DateIN" Title="Date In" Format="d" />
        <PropertyColumn Property="c => c.DateOUT" Title="Date Out" Format="d" />
        <PropertyColumn Property="c => c.GrandTotal" Title="Grand Total" />
        <PropertyColumn Property="c => c.Balance" Title="Balance" />
        <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="@(() => DoCheckOut(context.Item.ID))">Check Out</MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText>No guests to check out.</MudText></NoRecordsContent>
</MudDataGrid>

<MudText Typo="Typo.h6" Class="mb-2">Checkout Bills</MudText>
<MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
              OnDebounceIntervalElapsed="LoadCheckouts" DebounceInterval="300" Class="mb-2" />
<MudDataGrid Items="_checkouts" Dense="true" Hover="true" Elevation="2" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="c => c.BillNo" Title="Bill No" />
        <PropertyColumn Property="c => c.CheckIn != null && c.CheckIn.Guest != null ? c.CheckIn.Guest.GuestName : null" Title="Guest" />
        <PropertyColumn Property="c => c.CheckIn != null ? c.CheckIn.RoomNo : null" Title="Room" />
        <PropertyColumn Property="c => c.CheckOutDate" Title="Checkout Date" Format="d" />
        <PropertyColumn Property="c => c.CheckIn != null ? c.CheckIn.GrandTotal : null" Title="Grand Total" />
    </Columns>
    <PagerContent><MudDataGridPager /></PagerContent>
    <NoRecordsContent><MudText>No checkout bills.</MudText></NoRecordsContent>
</MudDataGrid>

@code {
    private IReadOnlyList<CheckInRoom> _checkedIn = [];
    private IReadOnlyList<CheckoutRoom> _checkouts = [];
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        await LoadCheckedIn();
        await LoadCheckouts();
    }

    private async Task LoadCheckedIn() =>
        _checkedIn = await CheckInSvc.GetCheckInsAsync("Checked In");

    private async Task LoadCheckouts() =>
        _checkouts = await CheckOutSvc.GetCheckoutsAsync(_search);

    private async Task DoCheckOut(int checkInId)
    {
        var confirmed = await DialogService.ShowMessageBox("Confirm Checkout",
            "Check out this guest and generate the bill?", yesText: "Check Out", cancelText: "Cancel");
        if (confirmed != true) return;
        try
        {
            var checkIn = await CheckInSvc.GetCheckInAsync(checkInId)
                ?? throw new InvalidOperationException($"Check-in {checkInId} not found");
            var bill = BillingCalculator.ComputeStay(
                checkIn.DateIN!.Value, checkIn.DateOUT!.Value,
                checkIn.RoomCharges ?? 0, checkIn.OtherCharges ?? 0,
                checkIn.DiscountPer ?? 0, checkIn.ServiceTaxPer ?? 0,
                checkIn.LuxuryTaxPer ?? 0, checkIn.TotalPaid ?? 0);
            await CheckOutSvc.CheckOutAsync(checkInId,
                new CheckoutRoom { CurrencyID = checkIn.CurrencyID },
                new TaxRoom
                {
                    EducationalTax = bill.EducessTax,
                    EducationalTaxAmount = bill.EducessTaxAmount,
                    HEduTax = bill.HEduCessTax,
                    HEduTaxAmount = bill.HEduCessTaxAmount,
                });
            Snackbar.Add("Successfully checked out", Severity.Success);
            await LoadCheckedIn();
            await LoadCheckouts();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
