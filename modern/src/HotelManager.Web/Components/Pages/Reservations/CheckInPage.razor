@page "/check-in"
@inject ICheckInService CheckInSvc
@inject HotelDbContext Db
@inject ISnackbar Snackbar

<PageTitle>Check In - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Room Check In</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudSelect @bind-Value="_guestId" Label="Guest" Required="true" RequiredError="Guest is required">
                    @foreach (var g in _guests)
                    {
                        <MudSelectItem Value="@g.GuestID">@g.GuestName (@g.GuestID)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Value="_roomNo" ValueChanged="RoomChanged" Label="Room No" Required="true" RequiredError="Room is required">
                    @foreach (var r in _rooms)
                    {
                        <MudSelectItem Value="@r.RoomNo">@r.RoomNo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_roomCharges" Label="Room Charges" Min="0" /></MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="_dateIn" Label="Date In" Required="true" RequiredError="Date In is required" /></MudItem>
            <MudItem xs="12" sm="2"><MudDatePicker @bind-Date="_dateOut" Label="Date Out" Required="true" RequiredError="Date Out is required" /></MudItem>
            <MudItem xs="12" sm="1"><MudNumericField @bind-Value="_adults" Label="Adults" Min="0" /></MudItem>
            <MudItem xs="12" sm="1"><MudNumericField @bind-Value="_kids" Label="Kids" Min="0" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_otherCharges" Label="Other Charges" Min="0" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_discountPer" Label="Discount %" Min="0" Max="100" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_serviceTaxPer" Label="Service Tax %" Min="0" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_luxuryTaxPer" Label="Luxury Tax %" Min="0" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_totalPaid" Label="Total Paid" Min="0" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_extraBed" Label="Extra Bed" />
            </MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_notes" Label="Notes" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="DoCheckIn">Check In</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Checked In Guests</MudText>
<MudDataGrid Items="_checkIns" Dense="true" Hover="true" Elevation="2" Filterable="true" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="c => c.ID" Title="ID" />
        <PropertyColumn Property="c => c.Guest != null ? c.Guest.GuestName : c.GuestID" Title="Guest" />
        <PropertyColumn Property="c => c.RoomNo" Title="Room" />
        <PropertyColumn Property="c => c.DateIN" Title="Date In" Format="d" />
        <PropertyColumn Property="c => c.DateOUT" Title="Date Out" Format="d" />
        <PropertyColumn Property="c => c.NoOfDays" Title="Days" />
        <PropertyColumn Property="c => c.ExtraBed" Title="Extra Bed" />
        <PropertyColumn Property="c => c.GrandTotal" Title="Grand Total" />
        <PropertyColumn Property="c => c.Balance" Title="Balance" />
        <PropertyColumn Property="c => c.Status" Title="Status" />
    </Columns>
    <PagerContent><MudDataGridPager /></PagerContent>
    <NoRecordsContent><MudText>No guests checked in.</MudText></NoRecordsContent>
</MudDataGrid>

@code {
    private MudForm _form = null!;
    private IReadOnlyList<CheckInRoom> _checkIns = [];
    private IReadOnlyList<Guest> _guests = [];
    private IReadOnlyList<Room> _rooms = [];
    private string? _guestId;
    private string? _roomNo;
    private int _roomCharges;
    private DateTime? _dateIn = DateTime.Today;
    private DateTime? _dateOut = DateTime.Today.AddDays(1);
    private int _adults = 1;
    private int _kids;
    private double _otherCharges;
    private double _discountPer;
    private double _serviceTaxPer;
    private double _luxuryTaxPer;
    private double _totalPaid;
    private bool _extraBed;
    private string? _notes;

    protected override async Task OnInitializedAsync()
    {
        _guests = await Db.Guests.OrderBy(g => g.GuestName).ToListAsync();
        _rooms = await Db.Rooms.OrderBy(r => r.RoomNo).ToListAsync();
        await Load();
    }

    private async Task Load() =>
        _checkIns = await CheckInSvc.GetCheckInsAsync("Checked In");

    private void RoomChanged(string roomNo)
    {
        _roomNo = roomNo;
        _roomCharges = _rooms.FirstOrDefault(r => r.RoomNo == roomNo)?.RoomCharges ?? 0;
    }

    private async Task DoCheckIn()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        try
        {
            await CheckInSvc.CheckInAsync(new CheckInRoom
            {
                GuestID = _guestId,
                RoomNo = _roomNo,
                RoomCharges = _roomCharges,
                DateIN = _dateIn,
                DateOUT = _dateOut,
                NoOfAdults = _adults,
                NoOfKids = _kids,
                OtherCharges = _otherCharges,
                DiscountPer = _discountPer,
                ServiceTaxPer = _serviceTaxPer,
                LuxuryTaxPer = _luxuryTaxPer,
                TotalPaid = _totalPaid,
                ExtraBed = _extraBed ? "Yes" : "No",
                Notes = _notes,
            });
            Snackbar.Add("Successfully checked in", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
