@page "/reports/restaurant-receipts"
@using HotelManager.Web.Services.Reports
@inject ReportDataService Data
@inject IReportService Reports
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Restaurant Receipts - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Restaurant Receipts</MudText>

<InvoicePickList Title="Restaurant orders" NumberLabel="Order No" NameLabel="&nbsp;"
                 Items="_items" OnExport="Export" />

@code {
    private IReadOnlyList<InvoicePickRow> _items = Array.Empty<InvoicePickRow>();

    protected override async Task OnInitializedAsync() =>
        _items = await Data.GetRestaurantReceiptPicksAsync();

    private async Task Export(InvoicePickRow row)
    {
        try
        {
            var pdf = await Reports.RenderRestaurantOrderReceiptPdfAsync(int.Parse(row.Id));
            await PdfDownload.DownloadAsync(JS, $"restaurant-receipt-{row.Number ?? row.Id}.pdf", pdf);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
