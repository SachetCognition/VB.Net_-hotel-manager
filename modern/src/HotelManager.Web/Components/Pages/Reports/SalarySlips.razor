@page "/reports/salary-slips"
@using HotelManager.Web.Services.Reports
@inject ReportDataService Data
@inject IReportService Reports
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Salary Slips - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Salary Slips</MudText>

<InvoicePickList Title="Employee payments" NumberLabel="Payment ID" NameLabel="Employee"
                 Items="_items" OnExport="Export" />

@code {
    private IReadOnlyList<InvoicePickRow> _items = Array.Empty<InvoicePickRow>();

    protected override async Task OnInitializedAsync() =>
        _items = await Data.GetSalarySlipPicksAsync();

    private async Task Export(InvoicePickRow row)
    {
        try
        {
            var pdf = await Reports.RenderSalarySlipPdfAsync(row.Id);
            await PdfDownload.DownloadAsync(JS, $"salary-slip-{row.Id}.pdf", pdf);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
