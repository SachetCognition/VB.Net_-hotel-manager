@page "/reports/employee-payments"
@using HotelManager.Web.Services.Reports
@inject ReportDataService Data
@inject IReportService Reports
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Employee Payments - Hotel Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Employee Payment Report</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="3"><MudDatePicker @bind-Date="_from" Label="From" /></MudItem>
        <MudItem xs="12" sm="3"><MudDatePicker @bind-Date="_to" Label="To" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_employeeId" Label="Employee ID" /></MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Apply</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="Export">Export PDF</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_rows" Dense="true" Hover="true" Elevation="2">
    <HeaderContent>
        <MudTh>Payment ID</MudTh><MudTh>Employee</MudTh><MudTh>From</MudTh><MudTh>To</MudTh><MudTh>Days</MudTh>
        <MudTh>Salary</MudTh><MudTh>Advance</MudTh><MudTh>Deduction</MudTh><MudTh>OT Amount</MudTh><MudTh>Paid On</MudTh><MudTh>Net Pay</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.PaymentID</MudTd>
        <MudTd>@context.EmployeeID @context.EmployeeName</MudTd>
        <MudTd>@context.DateFrom?.ToString("dd-MMM-yyyy")</MudTd>
        <MudTd>@context.DateTo?.ToString("dd-MMM-yyyy")</MudTd>
        <MudTd>@context.PresentDays</MudTd><MudTd>@context.Salary</MudTd>
        <MudTd>@context.Advance</MudTd><MudTd>@context.Deduction</MudTd><MudTd>@context.OverTimeAmount</MudTd>
        <MudTd>@context.PaymentDate?.ToString("dd-MMM-yyyy")</MudTd><MudTd>@context.NetPay</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No records found.</MudText></NoRecordsContent>
</MudTable>

@code {
    private DateTime? _from;
    private DateTime? _to;
    private string? _employeeId;
    private IReadOnlyList<EmployeePaymentRow> _rows = Array.Empty<EmployeePaymentRow>();

    private ReportRequest Request => new(_from, _to, string.IsNullOrWhiteSpace(_employeeId) ? null : _employeeId);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _rows = await Data.GetEmployeePaymentsAsync(Request);

    private async Task Export()
    {
        try
        {
            var pdf = await Reports.RenderEmployeePaymentReportPdfAsync(Request);
            await PdfDownload.DownloadAsync(JS, "employee-payment-report.pdf", pdf);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
